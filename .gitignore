# Nextflow runtime
nextflow/work/
nextflow/.nextflow/
nextflow/.nextflow.log*

# LSF job logs
nextflow/nil_pipeline_*.out
nextflow/nil_pipeline_*.err

# Pipeline outputs
results/

# Generated DAGs (regenerate with -preview -with-dag)
nextflow/dag.svg
nextflow/dag_dryrun.svg

# Claude Code / MCP local config
.claude/agents
.claude/commands
.claude/skills
.claude/settings.json.bak
.mcp.json

# Agent documentation (internal, not versioned)
agent/

# VS Code / IDE artifacts
.vscode/
.idea/

# Shell dotfiles (VS Code Remote SSH syncs these)
.bash_profile
.bashrc
.zshrc
.zprofile
.profile
.gitconfig
.ripgreprc

# Git internals leaked to worktree (VS Code SSH bug)
/HEAD
/config
/hooks
/refs
/objects
.gitmodules

# macOS
.DS_Store
._*

# Large bioinformatics files
*.maf
*.sam
*.bam
*.fa
*.fasta
*.gfa
*.fastq.gz
