params {
    samplesheet    = "${projectDir}/full_run_samplesheet.csv"
    outdir         = "/rsstu/users/r/rrellan/tlaloc/nilhifi/results"
    run_anchorwave = true

    // Reference genomes — B73 is global, ref2 is per-sample (set in samplesheet)
    refs {
        B73 {
            fa  = "/rsstu/users/r/rrellan/DOE_CAREER/inv4m/synteny/ref/B73/Zm-B73-REFERENCE-NAM-5.0.fa"
            gff = "/rsstu/users/r/rrellan/DOE_CAREER/inv4m/synteny/ref/B73/Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.gff3"
        }
        PT {
            fa  = "/rsstu/users/r/rrellan/DOE_CAREER/inv4m/synteny/ref/PT/Zm-PT-REFERENCE-HiLo-1.0.fa"
            gff = "/rsstu/users/r/rrellan/DOE_CAREER/inv4m/synteny/ref/PT/Zm-PT-REFERENCE-HiLo-1.0_Zm00109aa.1.gff3"
        }
        mexicana {
            fa  = "/rsstu/users/r/rrellan/DOE_CAREER/inv4m/synteny/ref/mexicana/Zx-TIL18-REFERENCE-PanAnd-1.0.fa"
            gff = "/rsstu/users/r/rrellan/DOE_CAREER/inv4m/synteny/ref/mexicana/Zx-TIL18-REFERENCE-PanAnd-1.0_Zx00002ab.1.gff3"
        }
        parviglumis {
            fa  = "/rsstu/users/r/rrellan/DOE_CAREER/inv4m/synteny/ref/parviglumis/Zv-TIL01-REFERENCE-PanAnd-1.0.fa"
            gff = "/rsstu/users/r/rrellan/DOE_CAREER/inv4m/synteny/ref/parviglumis/Zv-TIL01-REFERENCE-PanAnd-1.0_Zv00001aa.1.gff3"
        }
    }
}

profiles {
    lsf {
        process.executor = 'lsf'
        process.queue    = 'sara'
        executor.perJobMemLimit = true
    }
}

process {
    errorStrategy = 'retry'
    maxRetries    = 1
    beforeScript  = 'source /usr/local/apps/miniconda20240526/etc/profile.d/conda.sh'

    withLabel: assembly {
        conda = '/share/maize/frodrig4/conda/env/assembly'
    }
    withLabel: anchorwave {
        conda = '/share/maize/frodrig4/conda/env/anchorwave'
    }
    withLabel: liftoff {
        conda = '/share/maize/frodrig4/conda/env/liftoff'
    }
    withLabel: r_plotting {
        conda = '/share/maize/frodrig4/conda/env/r_plotting'
    }
}

// Work directory for intermediate files
workDir = "${params.outdir}/work"

// Use conda for environment management
conda.enabled = true

// Timeline and report
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
